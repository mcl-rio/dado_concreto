# ===========================================
# Configuração do Banco de Dados (Supabase)
# ===========================================
# Obtenha em: https://supabase.com/dashboard/project/_/settings/database
# Use a connection string do Supabase (PostgreSQL)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# ===========================================
# Configuração de Autenticação
# ===========================================
# Segredo para tokens JWT (gere uma string aleatória segura)
JWT_SECRET=sua-chave-secreta-aqui

# ID do proprietário do sistema (OpenID do admin principal)
OWNER_OPEN_ID=

# URL do servidor OAuth (se usando autenticação OAuth)
OAUTH_SERVER_URL=

# ID da aplicação
VITE_APP_ID=

# ===========================================
# Chaves de API para LLMs
# ===========================================
# Google Gemini - https://makersuite.google.com/app/apikey
GEMINI_API_KEY=

# OpenAI - https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic Claude - https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Deepseek - https://platform.deepseek.com/
DEEPSEEK_API_KEY=

# ===========================================
# Serviços Opcionais
# ===========================================
# Resend (envio de emails) - https://resend.com/
RESEND_API_KEY=

# News API (busca de notícias) - https://newsapi.org/
NEWS_API_KEY=

# Google Service Account (para serviços Google)
# JSON completo da conta de serviço, em uma linha
GOOGLE_SERVICE_ACCOUNT_JSON=

# ===========================================
# Configurações de Desenvolvimento
# ===========================================
# Modo de debug para análise passo a passo
DEBUG_COUNCIL_STEP_BY_STEP=false

# Porta do servidor (padrão: 3000)
PORT=3000

# Ambiente (development ou production)
NODE_ENV=development
